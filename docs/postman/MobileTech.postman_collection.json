      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse the JSON response\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "// Save the token as a collection variable\r",
                  "pm.collectionVariables.set(\"authToken\", response.data.token);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "\r\n// ADMIN\r\n{\r\n    \"email\": \"{{ADMIN_EMAIL}}\",\r\n    \"password\": \"{{ADMIN_PASSWORD}}\"\r\n}\r\n\r\n// Dev\r\n// {\r\n//     \"email\": \"{{DEV_EMAIL}}\",\r\n//     \"password\": \"{{DEV_PASSWORD}}\"\r\n// }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/auth/login",
